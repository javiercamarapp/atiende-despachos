# Base URL del backend FastAPI. Vacío (default) = same-origin — correcto en
# dev (el proxy de vite.config.ts reenvía /portal al backend) y en prod si
# ese mismo backend sirve este build (apps/web/dist) como estáticos.
# Solo se necesita un valor real si el frontend se hostea en un dominio
# distinto al backend.
VITE_API_URL=

# Solo dev: a dónde apunta el proxy de Vite para /portal cuando el backend
# no corre en localhost:8000 (el default de vite.config.ts).
VITE_BACKEND_URL=http://localhost:8000
